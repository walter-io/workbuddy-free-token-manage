{
  "name": "free-token",
  "private": true,
  "version": "0.1.2",
  "description": "多平台免费模型管理工具（OpenRouter / OpenCode Zen / Agnes AI / 硅基流动 / 魔搭等）：模型检索、免费额度、一键载入 WorkBuddy、Token 用量统计",
  "author": "walter-io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walter-io/workbuddy-free-token-manage.git"
  },
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "app": "electron .",
    "app:dir": "npm run build && electron-builder --dir --publish never",
    "app:win": "npm run build && electron-builder --win --publish never",
    "app:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
